<!-- 各ツールボタン -->

<section class="controls">
    <div class="l-inner bg-sub py-4 px-4 l-row l-row--gap sm:flex-col">
        {{! chatGPTボタン }}
        <button class="btn controls__btn bg-accent" id="btnChatGPT">
            <span></span>
            <i class="fa-solid fa-robot"></i>
            <p>chatGPT</p>
        </button>

        {{! 外部ページ移管ボタン ・後で内容書き換え}}
        <button class="btn controls__btn bg-accent" id="btnAmazon">
            <i class="fa-brands fa-amazon"></i>
            <p>Amazon</p>
        </button>

        <button class="btn controls__btn bg-accent" id="btnNotion">
            <i class="fa-solid fa-note-sticky"></i>
            <p>notion</p>
        </button>

        <button class="btn controls__btn nav-btn bg-accent" data-page="hint">
            <i class="fa-regular fa-lightbulb"></i>
            <p>コーディングツール</p>
        </button>

        {{! 運用ルールボタン：オーバーレイモーダルでmdを表示 }}
