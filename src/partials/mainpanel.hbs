<div class="main-panel l-row l-row--gap l-inner bg-color py-8 px-4 sm:py-6">

    <div class="left-panel l-column l-column--4 flex flex-col">
        <section class="stock-panel px-4 py-4 bg-sub color-text-sub">
            <div class="flex justify-between">
                <h3 class="en"><i class="fas fa-xmark mr-2 color-text"></i>Incomplete Tasks</h3>
                <button id="clear-done-stock" class="stock-clear color-text-sub">
                    完了済みを削除
                </button>
            </div>
            <ul id="stock-list" class="py-2"></ul>
        </section>

        <section class="today-log px-4 py-4 bg-sub color-text-sub mt-4">
            <h3 class="en"><i class="fas fa-circle-check mr-2  color-text"></i>Completed Tasks</h3>
            <ul id="today-log-list"></ul>
            <div class="today-summary mt-4 flex justify-end items-center">
                <i class="fas fa-stopwatch mr-2"></i>今日の作業時間：
                <span id="today-total-time">0秒</span>
            </div>
        </section>
    </div>

    <div class="right-panel l-column l-column--8 flex flex-col">
        {{!-- パネル上部 --}}
        <div class="l-row l-row--gap">

            {{!-- daily TODO --}}
            <div class=" l-column l-column--8 bg-sub">
                <div class="daily-todo py-4 px-4" aria-live="polite">
                    <h3 class="color-text-sub en"><i class="fas fa-calendar-day mr-2 color-text"></i>Daily TODO</h3>
                    <ul id="daily-list" class="color-text-sub"></ul>
                    <div class="flex justify-end">
                        <button type="button" id="move-to-stock" class="memo__move py-4 px-4 mt-2 rounded color-text">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                    </div>
                </div>
            </div>


            {{!-- 作業コントロールパネル --}}
            <div class="bg-sub l-column l-column--4 px-4 py-4">
                <h3 class="color-text-sub en"><i class="fas fa-hourglass-half color-text mr-2"></i>Task Controls</h3>
                {{!-- 作業計測タイマー --}}
                <div class="work-timer bg-accent py-4 px-4 rounded">
                    <div id="timer-display" class="timer__display text-center en font-bold">0秒</div>

                    <div class="l-row l-row--gap justify-center">
                        <button id="timer-start" class="timer__btn">▶</button>
                        <button id="timer-stop" class="timer__btn">⏸</button>
                        <button id="timer-reset" class="timer__btn">⏹</button>
                    </div>
                </div>

            </div>
        </div>

        {{!-- パネル下部 --}}
        <section class="memo-info card bg-sub mt-4">

            <div class="memo-info__grid">
                {{!--メモ欄 --}}
                <section class="memo l-row l-row--gap" aria-label="メモ・アイデア・ログ">
                    {{!-- インプット入力フォーム --}}
                    <form id="memo-form" class="memo__form l-column l-column--6 py-4 px-4">
                        <textarea id="memo-input" class="memo__input w-full" rows="3" maxlength="120"
                            placeholder="今日やることを追加"></textarea>

                        {{!-- 保存ボタンと削除ボタン --}}
                        <div class="memo__actions">
                            <button type="submit" class="memo__save py-4 px-4 rounded"><i
                                    class="fa-solid fa-check"></i></button>
                            <button type="button" id="memo-clear" class="memo__clear py-4 px-4 rounded"><i
                                    class="fa-solid fa-trash"></i></button>
                        </div>
                    </form>

                    {{!-- 保存ナビ --}}
                    <div class="l-column l-column--6 py-4 px-4">
                        <button id="openSaveWizard" type="button" class="wizard__btn btn btn--push"><span><i
                                    class="fa-solid fa-folder-tree pr-2"></i>保存ナビ</span></button>

                        {{!-- 以下、保存ナビモーダルの中身 --}}
                        <template id="saveWizardTemplate">
                            <div id="saveWizard" class="wizard">

                                {{!-- 保存ナビヘッダー --}}
                                <div class="wizard-head">
                                    <h3 class="wizard-sub pb-4">保存先の参照とファイル名の作成</h3>

                                    {{!-- ガイド用ドット --}}
                                    <div class="wizard-steps">
                                        <ol class="wizard-steps__dot">
                                            <li data-stepdot="1" class="is-active">1</li>
                                            <li data-stepdot="2">2</li>
                                            <li data-stepdot="3">3</li>
                                        </ol>
                                        {{!-- ガイド説明文 --}}
                                        <ol class="wizard-steps__label">
                                            <li>このファイルは何のデータか？</li>
                                            <li>案件情報</li>
                                            <li>ファイル生成</li>
                                        </ol>
                                    </div>
                                </div>

                                {{!-- 保存ナビフッター --}}
                                <div class="wizard-foot">
                                    <button type="button" id="backStep" class="btn btn--secondary wizard-foot__btn"><i
                                            class="fa-solid fa-arrow-left"></i></button>
                                    <div class="wizard-foot-right">
                                        <button type="button" id="copyPath"
                                            class="btn btn--primary wizard-foot__btn">パスだけ</button>
                                        <button type="button" id="copyName"
                                            class="btn btn--primary wizard-foot__btn">名前だけ</button>
                                        <button type="button" id="copyAll"
                                            class="btn btn--primary wizard-foot__btn">全部コピー</button>
                                    </div>
                                </div>

                                <div class="wizard-main">
                                    <section data-step="1" class="step step--1 active">
                                        <h3>【step1】このファイルは何データか？</h3>
                                        <button type="button" data-type="project">案件データ</button>
                                        <button type="button" data-type="client">顧客情報</button>
                                        <button type="button" data-type="asset">共有素材</button>
                                        <button type="button" data-type="inbox">迷った</button>
                                    </section>

                                    <section data-step="2" class="step step--2">
                                        <h3>【step2】案件情報</h3>
                                        <div class="project-group">
                                            <div class="project-group project-group--existing">
                                                <label>既存案件</label>
                                                <select id="projectHistory"></select>
                                            </div>

                                            <div class="project-group project-group--new">
                                                <label>新規案件</label>
                                                <input id="month" placeholder="2026-02">
                                                <input id="projectName" placeholder="案件名">
                                                <input id="companyName" placeholder="会社名">
                                            </div>
                                        </div>
                                        <label>保存先</label>
                                        <select id="folderType">
                                            <option value="01_brief">01_brief</option>
                                            <option value="02_source" selected>02_source</option>
                                            <option value="03_export">03_export</option>
                                            <option value="04_preview">04_preview</option>
                                            <option value="05_client_material">05_client_material</option>
                                            <option value="06_reference">06_reference</option>
                                            <option value="07_admin">07_admin</option>
                                        </select>

                                        <button id="toStep3" type="button" class="btn btn--secondary step__next">次へ</button>
                                    </section>

                                    <section data-step="3" class="step step--3">
                                        <h3>【step3】ファイル生成</h3>

                                        <select id="fileType">
                                            <option>logo</option>
                                            <option>banner</option>
                                            <option>lp</option>
                                            <option>site</option>
                                            <option>illust</option>
                                            <option>invoice</option>
                                            <option>contract</option>
                                        </select>

                                        <input id="contentName" placeholder="内容（top / main）">
                                        <input id="ext" placeholder=".ai">

                                        <pre id="result"></pre>

                                    </section>

                                </div>
                            </div>
                        </template>
                    </div>
            </div>
        </section>
    </div>

</div>

</div>